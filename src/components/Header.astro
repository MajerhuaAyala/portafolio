---
import { type Locale } from "@/i18n"
import type { Dictionary } from "@/i18n/types"
import { localePath, withBase } from "@/lib/paths"
import FileDownload from "./icons/FileDownload.astro"
import ThemeToggle from "./ThemeToggle.astro"

interface Props {
  locale: Locale
  dict: Dictionary
  alternatePath?: string
}

const { locale, dict, alternatePath = "" } = Astro.props
const cvHref = withBase(dict.contact.cvFile)
const homeHref = localePath(locale)

const links = [
  { href: `${homeHref}#proyectos`, label: dict.nav.projects },
  { href: `${homeHref}#experiencia`, label: dict.nav.experience },
  { href: `${homeHref}#habilidades`, label: dict.nav.skills },
  { href: `${homeHref}#sobre-mi`, label: dict.nav.about },
  { href: `${homeHref}#contacto`, label: dict.nav.contact },
]

const localeLinks = [
  { code: "es" as const, label: "ES" },
  { code: "en" as const, label: "EN" },
]
---

<header class="sticky top-0 z-30 border-b border-rule bg-paper">
  <a
    href="#content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-[12px] focus:border focus:border-rule focus:bg-paper focus:px-3 focus:py-2 focus:font-display focus:text-sm focus:font-semibold focus:text-ink"
  >
    {dict.ui.skipToContent}
  </a>
  <div class="shell flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
    <a href={homeHref} class="font-display text-lg font-extrabold tracking-[-0.02em] text-ink">
      MMA
    </a>

    <nav class="hidden items-center gap-x-4 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-display text-sm font-semibold tracking-[-0.02em] text-slate hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <nav aria-label={dict.ui.language} class="flex items-center gap-1 font-mono text-xs font-medium">
        {
          localeLinks.map((item, index) => (
            <>
              {index > 0 && (
                <span aria-hidden="true" class="text-rule">
                  |
                </span>
              )}
              <a
                href={localePath(item.code, alternatePath)}
                hreflang={item.code}
                lang={item.code}
                data-set-lang={item.code}
                aria-current={locale === item.code ? "true" : undefined}
                aria-label={`${dict.ui.switchTo} ${item.label}`}
                class:list={[
                  "px-0.5 tracking-[0.08em]",
                  locale === item.code ? "text-ink" : "text-slate hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </>
          ))
        }
      </nav>
      <ThemeToggle theme={dict.ui.theme} />
      <a
        href={cvHref}
        download
        class="cv-chip"
        aria-label={`${dict.hero.ctaCv} (PDF, ${dict.ui.language})`}
      >
        <FileDownload />
        <span class="hidden sm:inline">{dict.hero.ctaCv}</span>
        <span class="sm:hidden">{dict.nav.cv}</span>
        <span class="cv-chip-lang" aria-hidden="true">{locale.toUpperCase()}</span>
      </a>
    </div>
  </div>
  <script is:inline>
    ;(function () {
      var saved = null
      try {
        var raw = sessionStorage.getItem("lang-switch-scroll")
        sessionStorage.removeItem("lang-switch-scroll")
        if (raw) {
          var parsed = JSON.parse(raw)
          if (
            parsed &&
            typeof parsed === "object" &&
            typeof parsed.path === "string" &&
            (parsed.id === null || typeof parsed.id === "string") &&
            typeof parsed.progress === "number" &&
            Number.isFinite(parsed.progress) &&
            parsed.path === location.pathname
          ) {
            saved = { path: parsed.path, id: parsed.id, progress: parsed.progress }
          }
        }
      } catch (error) {
        saved = null
      }
      window.__langScroll = saved

      var apply = function () {
        if (!saved) return
        var header = document.querySelector("header")
        var offset = header ? header.getBoundingClientRect().height : 0
        var el = saved.id ? document.getElementById(saved.id) : null
        var target =
          saved.id && el
            ? el.getBoundingClientRect().top + window.scrollY + saved.progress * el.offsetHeight - offset
            : saved.progress * (document.documentElement.scrollHeight - window.innerHeight)
        window.scrollTo({ top: Math.max(0, target), behavior: "instant" })
        if (location.hash) history.replaceState(null, "", location.pathname + location.search)
      }

      if ("onpagereveal" in window) window.addEventListener("pagereveal", apply, { once: true })
      else if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", apply, { once: true })
      else apply()
    })()
  </script>
</header>

<script>
  type LangSwitchScroll = {
    path: string
    id: string | null
    progress: number
  }

  const clamp01 = (value: number) => {
    if (!Number.isFinite(value) || value < 0) return 0
    if (value > 1) return 1
    return value
  }

  const headerHeight = () => document.querySelector("header")?.getBoundingClientRect().height ?? 0

  const currentAnchor = (): Pick<LangSwitchScroll, "id" | "progress"> => {
    const offset = headerHeight()
    let current: HTMLElement | null = null
    for (const section of document.querySelectorAll<HTMLElement>("main section[id]")) {
      if (section.getBoundingClientRect().top <= offset + 1) current = section
    }
    if (!current) {
      const range = Math.max(1, document.documentElement.scrollHeight - window.innerHeight)
      return { id: null, progress: window.scrollY / range }
    }
    const rect = current.getBoundingClientRect()
    return { id: current.id, progress: clamp01((offset - rect.top) / rect.height) }
  }

  const anchorTop = (saved: LangSwitchScroll) => {
    const offset = headerHeight()
    const el = saved.id ? document.getElementById(saved.id) : null
    const target =
      saved.id && el
        ? el.getBoundingClientRect().top + window.scrollY + saved.progress * el.offsetHeight - offset
        : saved.progress * (document.documentElement.scrollHeight - window.innerHeight)
    return Math.max(0, target)
  }

  const reapplyScroll = () => {
    const saved = (window as Window & { __langScroll?: LangSwitchScroll | null }).__langScroll
    if (!saved || saved.path !== location.pathname) return
    const target = anchorTop(saved)
    if (Math.abs(target - window.scrollY) > 2) {
      window.scrollTo({ top: target, behavior: "instant" })
    }
    if (location.hash) {
      history.replaceState(null, "", location.pathname + location.search)
    }
  }

  if (document.readyState === "complete") reapplyScroll()
  else window.addEventListener("load", reapplyScroll, { once: true })

  document.querySelectorAll<HTMLAnchorElement>("[data-set-lang]").forEach((link) => {
    link.addEventListener("click", () => {
      const lang = link.dataset.setLang
      if (lang !== "es" && lang !== "en") return
      try {
        localStorage.setItem("lang", lang)
      } catch {
        /* ignore storage failures */
      }
      const { id, progress } = currentAnchor()
      const path = new URL(link.href, location.origin).pathname
      try {
        const payload: LangSwitchScroll = { path, id, progress }
        sessionStorage.setItem("lang-switch-scroll", JSON.stringify(payload))
      } catch {
        /* ignore storage failures */
      }
    })
  })
</script>
