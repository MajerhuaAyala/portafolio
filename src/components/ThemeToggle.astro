---
import type { Dictionary } from "@/i18n/types"
import MoonIcon from "./icons/Moon.astro"
import SunIcon from "./icons/Sun.astro"
import SystemIcon from "./icons/System.astro"

interface Props {
  theme: Dictionary["ui"]["theme"]
}

const { theme } = Astro.props
const options = [
  { id: "light", label: theme.light },
  { id: "dark", label: theme.dark },
  { id: "system", label: theme.system },
] as const
---

<div class="relative">
  <button
    type="button"
    id="theme-toggle-btn"
    class="flex size-10 items-center justify-center text-ink"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="themes-menu"
  >
    <span class="sr-only">{theme.label}</span>
    <SunIcon data-theme-icon="light" class="size-5" aria-hidden="true" />
    <MoonIcon data-theme-icon="dark" class="size-5" aria-hidden="true" />
    <SystemIcon data-theme-icon="system" class="size-5" aria-hidden="true" />
  </button>
  <div
    id="themes-menu"
    class="absolute right-0 z-40 mt-1 hidden min-w-36 rounded-[12px] border border-rule bg-surface py-1 text-sm"
    role="menu"
    aria-label={theme.label}
    hidden
  >
    <ul>
      {
        options.map((option) => (
          <li>
            <button
              type="button"
              class="theme-option block w-full px-3 py-2 text-left font-body text-ink"
              role="menuitemradio"
              data-theme-option={option.id}
              aria-checked="false"
            >
              {option.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const media = window.matchMedia("(prefers-color-scheme: dark)")
  const menu = document.getElementById("themes-menu")
  const toggle = document.getElementById("theme-toggle-btn")
  const options = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]")

  const preference = () => {
    try {
      const stored = localStorage.getItem("theme")
      if (stored === "light" || stored === "dark" || stored === "system") return stored
    } catch {
      /* ignore storage failures */
    }
    return "system"
  }

  const apply = () => {
    const theme = preference()
    const isDark = theme === "dark" || (theme === "system" && media.matches)
    document.documentElement.classList.toggle("dark", isDark)
    document.documentElement.dataset.theme = theme
    options.forEach((option) => {
      option.setAttribute("aria-checked", option.dataset.themeOption === theme ? "true" : "false")
    })
  }

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return
    menu.classList.toggle("hidden", !open)
    menu.toggleAttribute("hidden", !open)
    toggle.setAttribute("aria-expanded", open ? "true" : "false")
  }

  apply()
  media.addEventListener("change", apply)

  toggle?.addEventListener("click", (event) => {
    event.stopPropagation()
    const open = toggle.getAttribute("aria-expanded") !== "true"
    setOpen(open)
  })

  document.addEventListener("click", () => setOpen(false))
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false)
  })

  options.forEach((option) => {
    option.addEventListener("click", () => {
      const next = option.dataset.themeOption
      if (next !== "light" && next !== "dark" && next !== "system") return
      try {
        localStorage.setItem("theme", next)
      } catch {
        /* ignore storage failures */
      }
      apply()
      setOpen(false)
    })
  })
</script>
