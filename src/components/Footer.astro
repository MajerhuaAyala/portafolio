---
import type { Dictionary } from "@/i18n/types"

interface Props {
  dict: Dictionary
}

const { dict } = Astro.props
const year = new Date().getFullYear()
---

<footer id="site-footer" class="border-t border-rule">
  <div class="shell py-8">
    <p class="text-sm text-slate">
      <span class="font-mono">{year}</span>
      {" "}
      {dict.footer.rights}
    </p>
  </div>
</footer>
