---
import type { Locale } from "@/i18n"
import type { Dictionary } from "@/i18n/types"
import { formatDuration, formatPeriod, monthsBetween } from "@/lib/duration"
import Marked from "./Marked.astro"

interface Props {
  locale: Locale
  experience: Dictionary["experience"]
}

const { locale, experience } = Astro.props
const builtAt = new Date()
const entries = experience.items.map((item) => ({
  ...item,
  period: formatPeriod(item.start, item.end, experience.present, locale),
  tenure: formatDuration(monthsBetween(item.start, item.end, builtAt), experience.units),
}))
---

<section id="experiencia" class="shell py-16 md:py-24">
  <h2 class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em] text-ink">
    {experience.title}
  </h2>
  <p class="mt-3 max-w-2xl font-body text-lg leading-relaxed text-pretty text-slate">{experience.intro}</p>

  <ol class="timeline mt-10">
    {
      entries.map((item) => (
        <li>
          <h3 class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink">{item.company}</h3>
          <p class="mt-1 font-body text-lg text-ink">{item.role}</p>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="font-mono text-xs text-slate">{item.period}</span>
            <span class="tenure">{item.tenure}</span>
            {item.location && <span class="font-mono text-xs text-slate">{item.location}</span>}
          </p>
          <p class="mt-4 max-w-3xl font-body leading-relaxed text-pretty text-ink">{item.summary}</p>
          {item.achievements.length > 0 && (
            <ul class="mt-3 list-disc space-y-2 pl-5 font-body leading-relaxed text-ink">
              {item.achievements.map((achievement) => (
                <li>
                  <Marked text={achievement} />
                </li>
              ))}
            </ul>
          )}
          {item.technologies.length > 0 && (
            <p class="mt-4 font-mono text-xs leading-5 text-slate">{item.technologies.join(" · ")}</p>
          )}
        </li>
      ))
    }
  </ol>
</section>
