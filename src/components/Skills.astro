---
import type { Dictionary } from "@/i18n/types"

interface Props {
  skills: Dictionary["skills"]
}

const { skills } = Astro.props
const lastGroupSpansRow = skills.groups.length % 2 === 1
---

<section id="habilidades" class="shell py-16 md:py-24">
  <h2 class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em] text-ink">
    {skills.title}
  </h2>
  <p class="mt-3 max-w-2xl font-body text-lg leading-relaxed text-pretty text-slate">{skills.intro}</p>
  <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      skills.groups.map((group, index) => (
        <li
          class:list={[
            "min-w-0 rounded-[12px] border border-rule bg-surface p-5",
            lastGroupSpansRow && index === skills.groups.length - 1 && "md:col-span-full",
          ]}
        >
          <h3 class="font-display text-xl font-semibold tracking-[-0.02em] text-ink">{group.name}</h3>
          <p class="mt-2 font-body leading-relaxed text-pretty text-ink">{group.description}</p>
          {group.tools.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.tools.map((tool) => (
                <li class="chip">{tool}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</section>
