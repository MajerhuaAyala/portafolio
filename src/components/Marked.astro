---
import { splitMarked } from "@/lib/marked"

interface Props {
  text: string
}

const { text } = Astro.props
const segments = splitMarked(text)
---

{
  segments.map((segment) =>
    segment.type === "mark" ? <mark class="hl">{segment.value}</mark> : segment.value,
  )
}

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const marks = document.querySelectorAll<HTMLElement>("mark.hl")

  if (reduce) {
    /* Fully drawn by CSS. */
  } else if (!("IntersectionObserver" in window)) {
    marks.forEach((mark) => mark.classList.add("is-drawn"))
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add("is-drawn")
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.35 },
    )
    marks.forEach((mark) => observer.observe(mark))
  }
</script>
