---
import type { Dictionary } from "@/i18n/types"
import { publicImage } from "@/lib/imageMeta"
import { withBase } from "@/lib/paths"
import Marked from "./Marked.astro"

interface Props {
  hero: Dictionary["hero"]
  contact: Dictionary["contact"]
}

const { hero, contact } = Astro.props
const cvHref = withBase(contact.cvFile)
const photo = await publicImage("me.webp")
---

<section class="shell grid items-start gap-10 py-12 md:py-16 lg:grid-cols-12 lg:gap-12 lg:py-20" aria-labelledby="hero-name">
  <div class="min-w-0 lg:col-span-7">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="kicker">{hero.eyebrow}</span>
      <span class="inline-flex items-center gap-2 font-mono text-xs font-medium text-slate">
        <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true"></span>
        {hero.availability}
      </span>
    </p>
    <h1
      id="hero-name"
      class="mt-4 font-display text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold leading-[0.95] tracking-[-0.02em] text-balance text-ink"
    >
      {hero.name}
    </h1>
    <p class="mt-4 font-display text-[clamp(1.7rem,3.2vw,2.7rem)] font-semibold leading-[1.15] tracking-[-0.02em] text-pretty text-ink">
      <Marked text={hero.headline} />
    </p>
    <p class="mt-5 max-w-[42rem] font-body text-lg leading-relaxed text-pretty text-ink md:text-xl">
      {hero.lead}
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a class="btn btn-primary" href={cvHref} download>{hero.ctaCv}</a>
      <a class="btn btn-secondary" href={`mailto:${contact.email}`}>{hero.ctaEmail}</a>
      <a class="link-quiet" href={contact.linkedinUrl} rel="noreferrer" target="_blank">
        {hero.ctaLinkedin}
      </a>
    </div>
  </div>

  <aside class="min-w-0 rounded-[12px] border border-rule bg-surface p-5 lg:col-span-5" aria-labelledby="facts-title">
    <div class="flex items-center gap-4">
      <img
        src={photo.src}
        alt={hero.photoAlt}
        width={photo.width}
        height={photo.height}
        class="size-16 shrink-0 rounded-full border border-rule object-cover"
      />
      <h2 id="facts-title" class="font-display text-xl font-semibold tracking-[-0.02em] text-ink">
        {hero.factsTitle}
      </h2>
    </div>
    <dl class="mt-5">
      {
        hero.facts.map((fact) => (
          <div class="grid grid-cols-[minmax(6.25rem,38%)_minmax(0,1fr)] items-start gap-x-3 border-t border-rule py-3">
            <dt class="kicker">{fact.label}</dt>
            <dd class="font-body text-sm leading-snug text-ink">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </aside>
</section>
