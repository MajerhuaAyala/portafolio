---
import type { Locale } from "@/i18n"
import type { Dictionary, Project } from "@/i18n/types"
import { publicImage, type PublicImage } from "@/lib/imageMeta"
import { localePath } from "@/lib/paths"
import Marked from "./Marked.astro"
import ProjectCard from "./ProjectCard.astro"

interface Props {
  locale: Locale
  projects: Dictionary["projects"]
}

const { locale, projects } = Astro.props
const featured = projects.items.filter((item) => item.featured)
const rest = projects.items.filter((item) => !item.featured)
const covers = new Map<string, PublicImage>(
  await Promise.all(
    projects.items.map(async (project) => [project.slug, await publicImage(project.cover)] as const),
  ),
)

function caseHref(slug: string): string {
  return localePath(locale, `proyectos/${slug}`)
}

function coverFor(project: Project): PublicImage {
  const cover = covers.get(project.slug)
  if (!cover) throw new Error(`Missing cover for ${project.slug}`)
  return cover
}
---

<section id="proyectos" class="shell py-16 md:py-24">
  <h2 class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em] text-ink">
    {projects.title}
  </h2>
  <p class="mt-3 max-w-2xl font-body text-lg leading-relaxed text-pretty text-slate">{projects.intro}</p>

  {
    featured.map((project) => {
      const cover = coverFor(project)
      return (
        <article class="mt-8 rounded-[12px] border border-rule bg-surface p-4 md:p-6 lg:grid lg:grid-cols-2 lg:items-center lg:gap-8">
          <div class="overflow-hidden rounded-[12px] border border-rule">
            <img
              src={cover.src}
              alt={project.coverAlt}
              width={cover.width}
              height={cover.height}
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full object-cover"
            />
          </div>
          <div class="mt-5 min-w-0 lg:mt-0">
            <p class="kicker">{projects.featuredLabel}</p>
            <p class="kicker mt-3">
              {project.sector}
              {
                project.client && (
                  <>
                    <span aria-hidden="true"> · </span>
                    {project.client}
                  </>
                )
              }
            </p>
            <h3 class="mt-2 font-display text-3xl font-semibold tracking-[-0.02em] text-ink">
              {project.title}
            </h3>
            <p class="mt-3 font-body text-lg leading-relaxed text-pretty text-ink">
              <Marked text={project.summary} />
            </p>
            <p class="mt-4 font-body text-ink">{project.role}</p>
            {project.technologies.length > 0 && (
              <p class="mt-3 font-mono text-xs leading-5 text-slate">{project.technologies.join(" · ")}</p>
            )}
            <a class="link-quiet mt-6 inline-flex w-fit" href={caseHref(project.slug)}>
              {projects.viewCase}
              <span class="sr-only"> {project.title}</span>
            </a>
          </div>
        </article>
      )
    })
  }

  {
    rest.length > 0 && (
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {rest.map((project) => (
          <ProjectCard
            project={project}
            cover={coverFor(project)}
            href={caseHref(project.slug)}
            viewCase={projects.viewCase}
          />
        ))}
      </div>
    )
  }
</section>
