---
import type { Dictionary } from "@/i18n/types"

interface Props {
  about: Dictionary["about"]
}

const { about } = Astro.props
---

<section id="sobre-mi" class="shell py-16 md:py-24">
  <h2 class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.02em] text-ink">
    {about.title}
  </h2>
  <div class="mt-8 grid items-start gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
    <div class="min-w-0 space-y-4 font-body text-lg leading-relaxed text-pretty text-ink">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="min-w-0">
      <h3 class="kicker">{about.valuesTitle}</h3>
      <ol class="mt-4 space-y-5">
        {
          about.values.map((value) => (
            <li>
              <p class="font-display text-lg font-semibold tracking-[-0.02em] text-ink">{value.title}</p>
              <p class="mt-1 font-body leading-relaxed text-pretty text-slate">{value.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
