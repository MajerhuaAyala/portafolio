---
import type { Dictionary } from "@/i18n/types"

interface Props {
  brands: Dictionary["brands"]
}

const { brands } = Astro.props
---

<section class="border-y border-rule" aria-labelledby="brands-title">
  <div class="shell py-8 md:py-12">
    <h2 id="brands-title" class="kicker">{brands.title}</h2>
    <ul class="mt-5 flex flex-wrap items-baseline gap-x-12 gap-y-3 md:gap-x-16">
      {
        brands.items.map((name) => (
          <li class="font-display text-[clamp(1.6rem,3vw,2.4rem)] font-semibold tracking-[-0.02em] text-slate">
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>
