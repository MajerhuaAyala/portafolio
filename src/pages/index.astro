---
import { localizedPath } from "@/i18n"
import { withBase } from "@/lib/paths"

const paths = {
  es: localizedPath("es"),
  en: localizedPath("en"),
}
const site = Astro.site ?? new URL("https://majerhuaayala.github.io")
const alternateEs = new URL(paths.es, site).href
const alternateEn = new URL(paths.en, site).href
const canonical = new URL(withBase(""), site).href
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Marcelino Majerhua Ayala</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <script is:inline define:vars={{ paths }}>
      ;(function () {
        var lang = "en"
        try {
          var stored = localStorage.getItem("lang")
          if (stored === "es" || stored === "en") {
            lang = stored
          } else {
            var list =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || ""]
            var prefersEs = false
            for (var i = 0; i < list.length; i++) {
              if (String(list[i] || "").toLowerCase().indexOf("es") === 0) {
                prefersEs = true
                break
              }
            }
            lang = prefersEs ? "es" : "en"
          }
        } catch (e) {
          lang = "en"
        }
        location.replace(paths[lang])
      })()
    </script>
  </head>
  <body>
    <noscript>
      <a href={paths.es} hreflang="es">ES</a>
      <a href={paths.en} hreflang="en">EN</a>
    </noscript>
  </body>
</html>
